{# ========= 1.- EXTRACT WINNING CANDIDATES AS RAW STRINGS ========= #}
{%- set casper_preinstall  = preins_candidatos   | reject('none') | first | default('') -%}
{%- set casper_identity    = identity_candidatos | reject('none') | first | default('') -%}
{%- set casper_system      = system_candidatos   | reject('none') | first | default('') -%}
{%- set casper_repos       = repos_candidatos    | reject('none') | first | default('') -%}
{%- set casper_user        = user_candidatos     | reject('none') | first | default('') -%}
{%- set casper_ssh         = ssh_candidatos      | reject('none') | first | default('') -%}
{%- set casper_network     = network_candidatos  | reject('none') | first | default('') -%}
{%- set casper_packages    = packages_candidatos | reject('none') | first | default('') -%}
{%- set casper_storage     = storage_candidatos  | reject('none') | first | default('') -%}
{%- set casper_postinstall = postins_candidatos  | reject('none') | first | default('') -%}
{%- set casper_logging     = logging_candidatos  | reject('none') | first | default('') -%}
{# ========= 2.- CASPER SECTIONS DEFINITION WITH INTEGRATED SANITIZATION ========= #}
{%- set casper_sections = [
        { "header": " ",  "content": (casper_system   | default({})) | to_yaml | from_yaml , "indent": "2"},
        { "header": "apt:",           "content": (casper_repos    | default({})) | to_yaml | from_yaml },
        { "header": "identity:",      "content": (casper_identity | default({})) | to_yaml | from_yaml },
        { "header": "ssh:",           "content": (casper_ssh      | default({})) | to_yaml | from_yaml },
        { "header": "user-data:",     "content": (casper_user     | default({})) | to_yaml | from_yaml },
        { "header": "network:",       "content": (casper_network  | default({})) | to_yaml | from_yaml },
        { "header": "storage:",       "content": (casper_storage  | default({})) | to_yaml | from_yaml },
        { "header": "packages:",      "content": (casper_packages | default([])) | to_yaml | from_yaml },
        { "header": "late-commands:", "content": casper_postinstall | default('') }
      ]
-%}
{#
###############################
        RENDERING FILE
###############################
#}
#cloud-config
autoinstall:
{%- for section in casper_sections -%}
{%-   if section.content is defined and section.content | string | length > 0 -%}
{%-      if section.header | length > 0 %}
{{ blank }}{{ blank }}{{ section.header }}{{ eol }}
{%-      endif %}
{%-      set id = section.indent | default('4') | int -%}
{{ section.content | indent(id, first=true) }}
{%-   endif -%}
{%- endfor -%}
{#
###############################
              END
###############################
#}
{%-             endif -%}
{%-           endif -%}
{%-         endif -%}
{%-       endif -%}
{%-    endif -%}
{%- endif -%}