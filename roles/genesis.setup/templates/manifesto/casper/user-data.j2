#cloud-config
autoinstall:
  version: 1

  # =========================================================================
  # 1.- LOCALIZATION & IDENTITIES
  # =========================================================================
  locale: "{{ casper_system.locale | default('en_US.UTF-8') }}"
  keyboard:
    layout: "{{ casper_system.keyboard.layout | default('us') }}"
  identity:
    hostname: "{{ casper_system.identity.hostname }}"
    username: "{{ casper_system.identity.username }}"
    password: "{{ casper_system.identity.password }}"

  # =========================================================================
  # 2.- SECURITY & AUTHORIZED ACCESS KEYS
  # =========================================================================
  ssh:
    install-server: true
    authorized-keys:
{% for key in casper_auth['authorized-keys'] | default([]) %}
      - "{{ key }}"
{% endfor %}

  # =========================================================================
  # 3.- TELEMETRY & ENGINE LOGGING
  # =========================================================================
{% if casper_logging.remotes is defined %}
  logging:
{{ casper_logging | to_nice_yaml(indent=4) | indent(4, true) }}
{% endif %}

  # =========================================================================
  # 2.- CONNECTIVITY PROFILE (Universal Multi-NIC Loop Engine)
  # =========================================================================
  network:
    network:
      version: 2
      ethernets:
        {% for interface in casper_network if interface.ipv4 | string | trim != "" %}
        eno{{ loop.index }}:
          critical: {{ 'true' if loop.first else 'false' }}
          addresses:
            - "{{ interface.ipv4 }}"
          match:
            macaddress: "{{ interface.mac }}"
          set-name: "eno{{ loop.index }}"
          
          {% if loop.first %}
          gateway4: "{{ interface.gateway }}"
          nameservers:
            addresses:
              - "{{ interface.nameserver | default('10.10.51.5') }}"
          {% endif %}
        {% endfor %}

  # =========================================================================
  # 5.- MIRROR SOFTWARE SOURCES
  # =========================================================================
  apt:
    preserve_sources_list: false
    primary:
      - arches: [amd64, default]
        uri: "{{ }}"
    sources:
      ubuntu-genesis-mirror:
        source: |
          deb http://10.10.51 noble main restricted universe multiverse
          deb-src http://10.10.51 noble main restricted universe multiverse
  source:
    id: ubuntu-server
    search_drivers: false
{% if casper_repos | length > 0 %}
    mirror: "{{ casper_repos | first }}"
{% endif %}

  # =========================================================================
  # 6.- STORAGE DEFINITION (CORRECCIÓN: Mapeo dinámico desde la lista)
  # =========================================================================
  storage:
    layout:
      name: "{{ casper_storage[0].name | default('lvm') }}"

  # =========================================================================
  # 7.- COMPONENT DELIVERY SELECTION
  # =========================================================================
  packages:
{% for pkg in casper_packages %}
    - {{ pkg }}
{% endfor %}

  # =========================================================================
  # 8.- LIFECYCLE SCRIPTS HANDSHAKE (Early & Late Commands Matrices)
  # =========================================================================
  early-commands:
    - mkdir -p /run/tmpfiles.d
{% for pre in casper_preinstall %}
    - |
      cat << 'EOF' > {{ pre.path }}
      {{ pre.content | trim }}
      EOF
    - chmod +x {{ pre.path }}
{% endfor %}

  late-commands:
{% for cmd in casper_postinstall %}
    - - "sh"
      - "-c"
      - "{{ cmd }}"
{% endfor %}

{###############################
              END
 ##############################}
