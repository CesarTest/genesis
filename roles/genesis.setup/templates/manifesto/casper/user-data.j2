    - {device: disk-nvme0n1, size: 230G, wipe: superblock-recursive, number: 2, preserve: false, type: partition, id: partition-1}
    - {name: ubuntu-vg, devices: [partition-1], preserve: false, type: lvm_volgroup, id: lvm_volgroup-0}
    - {name: lv-root, volgroup: lvm_volgroup-0, size: 150G, type: lvm_partition, id: lvm_partition-0}
    - {name: lv-swap, volgroup: lvm_volgroup-0, size: 4G, type: lvm_partition, id: lvm_partition-1}
    - {name: lv-tmp, volgroup: lvm_volgroup-0, size: 10G, type: lvm_partition, id: lvm_partition-2}
    - {name: lv-docker, volgroup: lvm_volgroup-0, size: -1, type: lvm_partition, id: lvm_partition-3}
    - {fstype: fat32, volume: partition-0, type: format, id: format-0}
    - {fstype: ext4, volume: partition-2, type: format, id: format-6}
    - {fstype: xfs, volume: lvm_partition-0, type: format, id: format-1}
    - {fstype: swap, volume: lvm_partition-1, type: format, id: format-2}
    - {fstype: xfs, volume: lvm_partition-2, type: format, id: format-3}
    - {fstype: xfs, volume: lvm_partition-3, type: format, id: format-4}
    - {path: /boot/efi, device: format-0, type: mount, id: mount-0}
    - {path: /boot, device: format-6, type: mount, id: mount-6}
    - {path: /, device: format-1, type: mount, id: mount-1}
    - {path: '', device: format-2, type: mount, id: mount-2}
    - {path: /tmp, device: format-3, type: mount, id: mount-3}
    - {path: /var/lib, device: format-4, type: mount, id: mount-4}
{% else %}
    layout:
      name: lvm
      match: {}
{% endif %}
  late-commands:
    - echo 'indra ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/indra
    - sed -i 's|^root:.:|root:$1$HLvLgn43$n/B5bYQtDnht33lyu5vs2.:|' /target/etc/shadow
    - sed -i 's|#PermitRootLogin prohibit-password|PermitRootLogin yes|' /target/etc/ssh/sshd_config
    - /bin/bash /run/tmpfiles.d/bootorder.sh
