        serial: ST1000DM014*
    - path: /dev/sdb
      preserve: false
      type: disk
      id: disk-sdb
      match:
        serial: ST1000DM014*
    - name: md127
      raidlevel: container
      devices: [disk-sda, disk-sdb]
      preserve: false
      metadata: imsm
      type: raid
      id: raid-md127
    - name: md126
      raidlevel: raid1
      preserve: false
      wipe: superblock
      container: raid-md127
      type: raid
      id: raid-md126
    - {fstype: xfs, volume: raid-md126, preserve: false, type: format, id: format-5}
    - {path: /irtos, device: format-5, type: mount, id: mount-5}
