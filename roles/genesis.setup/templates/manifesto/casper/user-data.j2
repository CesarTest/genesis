#cloud-config
chpasswd:
  list: |
    installer:installer
  expire: False
write_files:
- path: /run/tmpfiles.d/bootorder.sh
  content: |
    #!/bin/bash
    BOOT_OS=$(/target/usr/bin/efibootmgr |egrep ubuntu|cut -b5-8|tr -s '\n' ',')
    BOOT_DEVICE=$(/target/usr/bin/efibootmgr |egrep -v "ubuntu|^Time|^BootC|^BootO|^Desired|^Mirror"|cut -b5-8|tr -s '\n' ','|sed 's/.$//')
    /target/usr/bin/efibootmgr -o ${BOOT_OS}${BOOT_DEVICE}
rsyslog:
  remotes:
    log_serv: "*.* @@{{ pxeServerIps[hostname] }}:5140"
autoinstall:
  version: 1
  # use interactive-sections to avoid an automatic reboot
  #interactive-sections:
  #  - locale
  apt:
    # even set to no/false, geoip lookup still happens
    geoip: no
    preserve_sources_list: false
    sources_list: |
      deb [trusted=yes] http://{{ pxeServerIps[hostname] }}/UB20 ./
  packages:
   - ubuntu-desktop-minimal
  user-data:
    disable_root: false
  identity:
    hostname: {{ hostname }}
    username: indra
    password: '$6$eooE5qxHWkjFMeCO$0Mri4P00K8tEYCqwlZFe.mgfuBKxZcn/ZLZeMq2gu71lSZ5lnuIocVRuDVdT075Kpoy9Tg6Bh2W8c6BBPX6761'
  keyboard:
    layout: us
  locale: en_US.UTF-8
  # interface name will probably be different
  network:
    network:
      version: 2
      ethernets:
        eno1:
          critical: true
          addresses:
            - {{ ip }}
          gateway4: {{ gateway }}
          match:
            macaddress: {{ mac }}
          set-name: eno1
  ssh:
    allow-pw: true
    authorized-keys: []
    install-server: true
  # this creates an bios_grub partition, /boot partition, and root(/) lvm volume
  storage:
    swap:
      size: 0
{% set diskPartition = machines[hostname]['diskPartition'] %}
{% if diskPartition == 'ProWSServer' %}
{#  1 Disk.- 2 X (SSD 512 GB ) >>>> RAID1 por software#}
{#  2 Disk.- 2 X (HDD 1 TB ) >>>> RAID1 por Hardware#}
    config:
    - {ptable: gpt, path: /dev/nvme0n1, wipe: superblock-recursive, preserve: false, type: disk, id: disk-nvme0n1}
    - {ptable: gpt, path: /dev/nvme1n1, wipe: superblock-recursive, preserve: false, type: disk, id: disk-nvme1n1}
    - {device: disk-nvme0n1, size: 1G, flag: boot, number: 1, preserve: false, grub_device: true, type: partition, id: partition-0}
    - {fstype: fat32, volume: partition-0, preserve: false, type: format, id: format-0}
    - {device: disk-nvme0n1, size: 460G, preserve: false, number: 2, type: partition, id: partition-1}
    - {device: disk-nvme1n1, size: 460G, preserve: false, number: 1, type: partition, id: partition-2}
    - name: md0
      raidlevel: raid1
      devices: [partition-1, partition-2]
      preserve: false
      type: raid
      id: raid-0
    - fstype: xfs
      id: format_raid-0
      type: format
      volume: raid-0
    - name: ubuntu-vg
      devices: [raid-0]
      preserve: false
      type: lvm_volgroup
      id: lvm_volgroup-0
    - {name: lv-root, volgroup: lvm_volgroup-0, size: 150G, preserver: false, type: lvm_partition, id: lvm_partition-0}
