{%-            if j2_input is iterable -%}
{%-               if j2_input|length > 0 -%}
{# 
###############################
         CAPTURE VALUES
###############################
#}
{%-  set blank = " " -%}
{%-  set eol = "\n" -%}
{#......... 1.- Node Data Model ..... #}
{%-  set casper_model    = j2_profile | default('none') -%}
{%- set preins_candidatos = [
