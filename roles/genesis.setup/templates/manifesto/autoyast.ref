#!/bin/bash
set -e

# =======================================================================
# A. HARDEN ROOT ACCOUNT (Disable direct external access)
# =======================================================================
usermod -p "!" root

# =======================================================================
# B. PROVISION AUTOMATION USER WITH SYNCHRONIZED INDUSTRIAL IDs
# =======================================================================
if ! id -u cesar >/dev/null 2>&1; then
  useradd -m -u 1001 -g users -s /bin/bash cesar
fi

# Lock standard cleartext password entry mechanisms
usermod -p "!" cesar  

# Grant privileged sudo rights without operational password prompts
mkdir -p /etc/sudoers.d
echo 'cesar ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/cesar
chmod 440 /etc/sudoers.d/cesar

# =======================================================================
# C. INJECT ANSIBLE CORE PUBLIC KEY INTO IMMUTABLE STORAGE TARGET
# =======================================================================
mkdir -p /home/cesar/.ssh
echo "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMLeUbawucLN+B+Ilbsw/np4b2a/upqAF66MaPWgA05p Cesar@Tuxedo" > /home/cesar/.ssh/authorized_keys

# Enforce standard OpenSSH authorization security permissions matrix
chown -R cesar:users /home/cesar/.ssh
chmod 700 /home/cesar/.ssh
chmod 600 /home/cesar/.ssh/authorized_keys

# Hide the provisioning service account from greeting managers
mkdir -p /var/lib/AccountsService/users/
echo -e "[User]\nSystemAccount=true" > /var/lib/AccountsService/users/cesar

# =======================================================================
# D. REWRITE ACTIVE SECURE DAEMON POLICIES (sshd_config)
# =======================================================================
mkdir -p /etc/ssh/sshd_config.d
sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/g' /etc/ssh/sshd_config
sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin no/g' /etc/ssh/sshd_config
       
# Purge vendor drop-in overrides to guarantee strict configuration dominance
rm -f /etc/ssh/sshd_config.d/*.conf

# Habilitar obligatoriamente el demonio SSH deshabilitado de fábrica en SUSE
systemctl enable sshd.service || true
        ]]></source>
