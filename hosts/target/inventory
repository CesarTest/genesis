all:

  #--------------------------------------------------------------------
  #  GLOBAL ENVIRONMENT
  #--------------------------------------------------------------------
  vars:
  
    # => 1.- Genesis Node NICs
    git_branch: "stable/2026.1"
    genesis_nics:
      inband: 
        mac: "bc:24:11:4c:37:14"
        ip: "10.10.51.5/24"
        gateway: "10.10.51.1"
      outband: 
        mac: "bc:24:11:c1:ec:1a"
        ip: "10.10.41.5/24"
        gateway: "10.10.41.1"
      internet: 
        mac: "bc:24:11:34:c8:96"
        ip: "192.168.1.40/24"
        gateway: "192.168.1.1" 
        default_route: yes
        dns: "192.168.1.1"

    # => 2.- BMC Emulators shared credentials
    genesis_bmc_credentials: 
      fake_hardware:
        username: "root@pam"
        password: "cesardgm"
      redfish:
        ipv4: "192.168.1.133" # Proxmox Hypervisor 
        port: "8000"          # Proxmox RedFish Daemon
        username: "root@pam"
        password: "cesardgm"
        verify_ca: false

  #--------------------------------------------------------------------
  #  HOST_VARS: HARDWARE PROFILE DECLARED IN IRONIC API FORMAT
  #--------------------------------------------------------------------
  hosts:   
    localhost:
      ansible_host: "127.0.0.1"
      ansible_connection: "local"
  
    proxmox:
      ansible_host: "{{ genesis_bmc_credentials.redfish.ipv4 | default('192.168.1.133') }}"
 
    genesis:
      ansible_host: "{{ genesis_nics.inband.ip | default('127.0.0.1') | ansible.utils.ipaddr('address') }}"
  
  #--------------------------------------------------------------------
  #  GROUP_VARS: SOFTWARE PROFILE ASSIGNATION TO HOSTS
  #-------------------------------------------------------------------- 
  children:
    target:
      hosts: 
        localhost:
      vars:
        ansible_user: "javier"
        ansible_become_pass: "malo"

    hypervisor:
      hosts:
        proxmox:
      vars:
        ansible_user: root
        ansible_become_pass: cesardgm

    emulation:
      hosts:
        genesis:
      vars:
        ansible_user: "javier"
        ansible_become_pass: "malo"