#---------------------------------
# COPY DOWNLOADED OS IMAGES
#---------------------------------
- hosts: target
  become: true
  ignore_errors: yes
  vars:
    default_repo_path: "{{ playbook_dir  }}/../repo"
    bifrost_repo_path: "{{ bifrost_airgap_path | default( default_repo_path ) | realpath }}"
    
  tasks:
    - name: casa
      file: "{{ironic_tftp_master_path | default('/var/lib/ironic/master') }}"
      state: "directory"
      recursive: yes
      owner: ironic
      group: ironic 
      
    - name: "STEP 1: Copy Downloaded Files to Ironic Folder"
      ansible.builtin.copy:
        src: "{{bifrost_repo_path | realpath}}/"
        dest: "{{ironic_tftp_master_path | default('/var/lib/ironic/master') }}/"

#---------------------------------
# INSTALL STANDALONE IRONIC
#---------------------------------
- ansible.builtin.import_playbook: "{{bifrost_shoot_path|trim}}/install.yaml"
  #become: true
  vars:
    bifrost_shoot_path: >-
     {{ bifrost_playbooks_path 
      | default(playbook_dir + '/../roles/openstack.bifrost/openstack.bifrost/playbooks', True)       
      | realpath  }}
    create_image_via_dib: false


#---------------------------------
# SETUP STANDALONE IRONIC
#---------------------------------
- hosts: target
  become: true
  tasks:
 
     - name: "OVER CLOUD: adjust config file if VMs instead Baremetal Node"
       ansible.builtin.lineinfile:
         path: /etc/ironic/ironic.conf
         regexp: "{{replace.regexp}}"
         line: "{{replace.line}}"
       loop:
         - regexp: '^automated_clean'
           line: 'automated_clean = false'
         - regexp: '^enabled_deploy_interfaces '
           line: 'enabled_deploy_interfaces = ramdisk,bootc,direct,anaconda'
       loop_control:
         loop_var: "replace"  
         
     - name: "OVERCLOUD: restart service"
       service: 
         name: ironic
         state: restarted 
