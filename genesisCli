#========================================================
#   Function: runChecks
#--------------------------------------------------------
#  Run verifications
#========================================================
function runChecks() {
   if [ -n "${CHECK_CMD}" ] ; then 
	   local INDEX_CMD="0"
	   
       while [[ "${INDEX_CMD}" < "${#CHECK_CMD[@]}" ]] ; do

		  # 0.- Get Command	     
	      local COMMAND="${CHECK_CMD[${INDEX_CMD}]}"
  		  
		  # 1.- Get Verification Name
		  if [ -n "${CHECK_NAME}" ] ; then 
		     if [ "${INDEX_CMD}" -lt "${#CHECK_NAME[@]}" ] ; then
		        local PRINT_NAME="${CHECK_NAME[${INDEX_CMD}]}"
		     fi
		  fi
		  
		  # 2.- Get Ansible AdHoc Module
		  if [ -n "${CHECK_MODULE}" ] ; then 
		    unset ANSIBLE_MODULE
		    if [ "${INDEX_CMD}" -lt "${#CHECK_MODULE[@]}" ] ; then
		       local ANSIBLE_MODULE="${CHECK_MODULE[${INDEX_CMD}]}"
		    fi
         fi			
          
		  # 3.- Print Results
          if [ -n "${CHECK_ANSIBLE}" ] ; then
		     echo -e "${PRINT_NAME}"
		     runAdHoc "${ANSIBLE_MODULE}" "${COMMAND}"  "${CALL_LOG}"
		  else
		     local PRINT_STATUS=$( timeout 3 ${COMMAND} )
			 echo -e "${PRINT_NAME} ${COLOR[$SILVER]} ${PRINT_STATUS} ${COLOR[$NC]}"
		  fi
		  
          # 5.- Update the loop		  
		  local INDEX_CMD=$(expr ${INDEX_CMD} + 1)
		  
       done	   
   fi   
   unset ANSIBLE_MODULE COMMAND PRINT_NAME
}

