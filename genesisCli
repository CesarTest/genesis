        if [ -n "${RUN_ACTION}"     ] ; then
            initParameters "${RUN_ACTION}"
	        state_status "genesis_machine_ready" 2>&1 > "${LOG_FILE}"
            runActions     "${RUN_ACTION}"    2>&1 >>"${LOG_FILE}"
        fi

        # 2.- Menu System
        if [ -n "${MENU}" ] ; then
		   state_status "genesis_machine_ready"
		   startMenu 
		fi

        # 4.- Exit
		exit "$OUT"
	else
		error -noOwner "./"
        exit "$ERROR"
	fi
else
	error -noWrite "/dev/null"
    exit "$ERROR"
fi
