#========================================================
#   Function: reemplazoParametro
#--------------------------------------------------------
#   Replace text in configuration file
#========================================================
function reemplazaParametro() {

	local REEMPLAZA_LINEA="$1"
	local SEPARADOR_CAMPO='='
	if [ -n "${CNF_SEPARADOR_CAMPO[${POSICION}]}" ] ; then local SEPARADOR_CAMPO="${CNF_SEPARADOR_CAMPO[${POSICION}]}" ; fi 
	if [ -w "${CNF_REEMPLAZO[${POSICION}]}" ] ; then
	   if [ -n "${REEMPLAZA_LINEA}" ] ; then
	   	 REPLN="${VAR}${SEPARADOR_CAMPO}\"${PREPO}${VALOR}\""
	   	 echo "===> sed s|^${VAR}${SEPARADOR_CAMPO}.*$|$REPLN| ${CNF_REEMPLAZO[${POSICION}]} > ${OUT_TMP}"
	   	 sed "s|^${VAR}${SEPARADOR_CAMPO}.*$|$REPLN|" "${CNF_REEMPLAZO[${POSICION}]}" > "${OUT_TMP}"
	   else
	   	 REPLN="${PREPO}${VALOR}"
	   	 echo "===> sed s|${VAR}|$REPLN|g ${CNF_REEMPLAZO[${POSICION}]} > ${OUT_TMP}"
	   	 sed "s|${VAR}|$REPLN|g" "${CNF_REEMPLAZO[${POSICION}]}" > "${OUT_TMP}"
	   fi
	else
	   error "-w" "${CNF_REEMPLAZO[${POSICION}]}"
	fi
    OUT="$?"
}

#========================================================
#   Function: deployMenu
#--------------------------------------------------------
#   Deploy menu according to properties in data model
#========================================================
function deployMenu() {

    #------------------
	# ENTORNO LOCAL
	#------------------
	local REEMPLAZA_LINEA="$1"
	local POSICION="0"
    local VAR VALOR PREPO

	#------------------
	# ACCIONES
	#------------------

	# 1.- Display Text of the Menu
	#--------------------
	if [ -n "${MENU_TEXT}" ] ; then
	   echo -e "${MENU_TEXT}"
	   unset MENU_TEXT
	fi

	# 2.- Capture sequence of parameters
	#--------------------
	while [ "${POSICION}" -lt "${#PARAMETRO[@]}" ] ; do

		# 2.1.- Capture Variable and Value
		#--------------------------------
		VAR="${PARAMETRO[${POSICION}]}"
		VALOR="${!VAR}"

		# 2.2.- Request and Capture Value
		#------------------------------------
		if [ ! -n "${VALOR}" ] && [ -n "${SOLICITA_PARAMETRO[${POSICION}]}" ] ; then

			# 2.2.1.- Capture Parameter
			echo ""
			echo -e "${SOLICITA_PARAMETRO[${POSICION}]}"
			capturaValor "${POSICION}"

			# 2.2.2.- Print resulting value
			echo -e " Resulting Option: [${VALOR}]"

                        # 2.2.3.- Break Menu Display 
			if [ -n "${MENU_BREAK_TEXT}" ] ; then
			   if [ "${MENU_BREAK_TEXT}" == "${POSICION}" ] ; then unset RUTA_OPCIONES ; fi
			fi
		fi
		
		# 2.3.- Value Treatment
		#-----------------------------
		PREPO=""

		# 2.3.1.- CNF for text Replacement
		if [ -n "$VALOR" ] && [ -n "${CNF_REEMPLAZO[$POSICION]}" ] ; then

			#    2.3.1.1.- Replace / for \/ for the sed command
			#            BEWARE: dump results to temporal file in order to avoid issues with bash of different systems
			echo "${VALOR}" | awk 'BEGIN{FS="/"} {linea=$1;for(i=2;i<=NF;i++) {linea=linea "\\/" $i }} END{print linea}' > "${OUT_TMP}"
			VALOR=`cat "${OUT_TMP}"`

			#   2.3.1.2.- Add preposition
			PREPO="${PREPOSICION[${POSICION}]}"
               if [ -n "${CNF_REEMPLAZO[${POSICION}]}" ] ; then 
                 reemplazaParametro "${REEMPLAZA_LINEA}"
			     local PERMISSIONS=$(stat -c "%a %n" ${CNF_REEMPLAZO[${POSICION}]} | awk '{print $1;}')
			     chmod "$PERMISSIONS" "${OUT_TMP}"
		         mv "${OUT_TMP}" "${CNF_REEMPLAZO[${POSICION}]}"				
               fi
		fi 
		
		# 2.3.2.- Capture List Value
		if [ -n "$VALOR" ] ; then
                    echo "${VAR}='${VALOR}'" > "${OUT_TMP}"
                    . "${OUT_TMP}"
		fi

		# 2.4.- Loop index update
		#----------------------------
		POSICION=`expr "${POSICION}" +  1`
	done


	# 3.- Restore loop Environment
	#--------------------
        OUT="$?"
	unset VALOR VAL PREPO POSICION
}

