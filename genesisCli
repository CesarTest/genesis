#========================================================
#   Function: capturaOpcionLista
#--------------------------------------------------------
#  Capture option value from list of available options
#========================================================
function capturaOpcionLista() {

	# 1.- Espera Entrada
	#--------------------
	eval read -e INDICE_OPCION

	# 2.- Evalua Entrada
	#--------------------
	# Se introdujo una opcion ----------------------------- COMPROBACION 1
	if [ -n "${INDICE_OPCION}" ] ; then
		VALOR=""
		while [ ! -n "$VALOR" ] ; do

			# La opcion es un numero  ------------- COMPROBACION 2
			if [ "${INDICE_OPCION}" -eq "${INDICE_OPCION}" 2> /dev/null ]; then

				# La opcion es numero valido -- COMPROBACION 3
				if [ "${INDICE_OPCION}" -le "${NUM_OPCIONES}" ] ; then
					VALOR="${ELEMENTOS_MENU[${INDICE_OPCION}]}"

				# La opcion es numero valido -- COMPROBACION 3
				else
					echo -e "[${INDICE_OPCION}] - No valid Option [0-${NUM_OPCIONES}], please try again"
					eval read -e INDICE_OPCION
					if [ ! -n "${INDICE_OPCION}" ] ; then break ; fi
				fi

			# La opcion es un numero  ------------- COMPROBACION 2
			else
				echo -e "[${INDICE_OPCION}] - No numeric value introduced, please try again"
				eval read -e INDICE_OPCION
				if [ ! -n "${INDICE_OPCION}" ] ; then break ; fi
			fi
		done
	fi
}

#========================================================
#   Function: capturaValor
#--------------------------------------------------------
#  Capture Value in two different use cases
#    Case 1.- List of Values
#         1.1.- Display list of Strings as options
#         1.2.- Display list of files from a folder
#    Case 2.- Text input
#========================================================
function capturaValor() {

	#------------------
	# LOCAL ENVIRONMENT
	#------------------
	local INDICE="$1"
	local RUTA_LISTA="${RUTA_OPCIONES[${INDICE}]}"

	#-----------------
	# ACTIONS
	#-----------------

	# 1.- List of Options
	#--------------------
	if [ -n "${RUTA_LISTA}" ] ; then

	    # 1.1.- List of files from a folder as Options
	    if [ -r "${RUTA_LISTA}" ] ; then

		    # 1.1.1.- Build list and Capture option
		    listaOpciones_Dinamica "${INDICE}"
		    capturaOpcionLista

		    # 1.1.2.- Assign default value
            if [ ! -n "${VALOR}" ] ; then
                 local INDICE_OPCION="${VALOR_DEFECTO[${POSICION}]}"
                 VALOR="${ELEMENTOS_MENU[${INDICE_OPCION}]}"
	    fi

             # 1.2.- List of Strings as Options
	else
		listaOpciones_Estatica "${INDICE}"
		capturaOpcionLista
	fi

	# 2.- Plain Input
	#--------------------
	else
		eval read -e VALOR
	fi

	# 3.- Default Value
	#--------------------
        if [ ! -n "${VALOR}" ] ; then
		VALOR="${VALOR_DEFECTO[${POSICION}]}"
        fi
}


