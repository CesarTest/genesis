#========================================================
#   Function: passwordlessDetection
#--------------------------------------------------------
#  -Generate User SSH key in localhost
#  -Ensure localhost passwordless access
#========================================================
function passwordlessDetection() {

    #------------------
    # LOCAL ENVIRONMENT
    #------------------
    local HOST="${1}"
    local USER="${2}"
    local USER_PASSWORD="${3}"	
    local SSH_TIMEOUT="3"

    #------------------
    # ACTIONS
    #------------------
	
	# 1.- Passwordless Detection
    local PASSWORDLESS_DETECTED=$(ssh -oBatchMode='yes' -oConnectTimeout="${SSH_TIMEOUT}" -oStrictHostKeyChecking='no' ${USER}${HOST} 'echo DONE' 2> /dev/null)
	if [ -n "${OKD_CLUSTER_NAME}" ] ; then 
       local PASSWORDLESS_OKD=$(ssh -i "/home/okd/.ssh/${OKD_CLUSTER_NAME}" -oBatchMode='yes' -oConnectTimeout=${SSH_TIMEOUT} -oStrictHostKeyChecking='no' core@${HOST} 'echo DONE' 2> /dev/null)
	fi
	
	# 2.- Trying to establish passwordless connection
    if [[ "${PASSWORDLESS_DETECTED}" == "DONE" ]] ; then
        echo -e "[genesisCli.passwordlessDetection] - ${COLOR[$SEA]}Passwordless already Enabled at ${USER}${HOST}${COLOR[$NC]}"
	elif [[ "${PASSWORDLESS_OKD}" == "DONE" ]] ; then
	    echo -e "[genesisCli.passwordlessDetection] - ${COLOR[$SEA]}Passwordless already Enabled at [su - okd] core@${HOST}${COLOR[$NC]}"
    elif [ -x "/bin/ssh-copy-id" ] || [ -x "/sbin/ssh-copy-id" ] ; then

        echo "rm -f ${HOME}/.ssh/known_hosts"		
		rm -f "${HOME}/.ssh/known_hosts"
		   
	    if [ -n "${USER_PASSWORD}" ] ; then
		   echo "[genesisCli.passwordlessDetection] -  sshpass -p ${USER_PASSWORD} ssh-copy-id -oConnectTimeout=${SSH_TIMEOUT} -oStrictHostKeyChecking='no' ${USER}${HOST} 2> ${OUT_TMP}" 
           sshpass -p "${USER_PASSWORD}" ssh-copy-id -oConnectTimeout="${SSH_TIMEOUT}" -oStrictHostKeyChecking='no' "${USER}${HOST}" 2> "${OUT_TMP}"
		else
		   echo "[genesisCli.passwordlessDetection] - ssh-copy-id -oConnectTimeout=${SSH_TIMEOUT} -oStrictHostKeyChecking='no' ${USER}${HOST} 2> ${OUT_TMP}"
		   ssh-copy-id -oConnectTimeout="${SSH_TIMEOUT}" -oStrictHostKeyChecking='no' "${USER}${HOST}" 2> "${OUT_TMP}"
		fi 
        local SUCCESS="$?"
        local OUTPUT_COPY=$(cat ${OUT_TMP} | grep ERR)
		
		if [[ "${SUCCESS}" == "0" ]] ; then
		    echo -e "[genesisCli.passwordlessDetection] - ${COLOR[$SEA]}Passwordless was successfully Established at ${USER}${HOST}? [$SUCCESS] (OK=$OK, ERROR=$ERROR) ${OUTPUT_COPY}${COLOR[$NC]}"
		else
             echo -e "[genesisCli.passwordlessDetection] - ${COLOR[$RED]}Passwordless was not successfully Established at ${USER}${HOST}? [$SUCCESS] (OK=$OK, ERROR=$ERROR) ${OUTPUT_COPY}${COLOR[$NC]}"		
		fi

    fi
    OUT="$?"
}

#========================================================
#   Function: sshUserKey
#--------------------------------------------------------
#  -Generate User SSH key in localhost
#  -Ensure localhost passwordless access
#========================================================
function sshUserKey() {

	#---------------------
	#  ACTIONS
	#---------------------
	
    # 1.- Create SSH folder
    #-----------------------
    if [ ! -e "${HOME}/.ssh" ] ; then
       mkdir -p "${HOME}/.ssh"
       chmod 700 "${HOME}/.ssh"
    fi

    # 2.- Detect SSH Keys
    #-----------------------
    local KEYS=$(ls ${HOME}/.ssh/*pub 2> /dev/null)
    echo -e ".... User SSH Keys detected: \n$KEYS"
    if [ ! -n "${KEYS}" ] ; then
       if [ -x "/bin/ssh-keygen" ] || [ -x "/sbin/ssh-keygen" ] ; then
          echo "............................................................................"
          echo " No SSH Key detected on this user... we proceed with interactive generation"
		  echo "     ssh-keygen -b 2048 -t rsa -f ${HOME}/id_rsa -q -N ' ' "
          echo "............................................................................"
          ssh-keygen -b 2048 -t rsa -f "${HOME}/.ssh/id_rsa" -q -N "" 
      else
	      error "-x" "[genesisCli.sshUserKey] - /bin/ssh-keygen || /sbin/ssh-keygen"
       fi
    else
	   echo "[genesisCli.sshUserKey] - Detected Keys [${KEYS}]" 
	fi

    # 3.- Localhost Passwordless SSH Access
    #-----------------------
    local USER="$(whoami)"
    passwordlessDetection "localhost" "${USER}@" "${GENESIS_ROOT_PASSWORD}"
}

#========================================================
#   Function: trust_relationships
#--------------------------------------------------------
#  -Load Inventory list of hosts
#  -Ensure String passwordless access
#========================================================
function trust_relationships() {

    #---------------------------
    # LOCAL ENVIRONMENT
    #---------------------------
    if [ ! -n "${BAREMETAL_ROOT_PASSWORD}" ] ; then local BAREMETAL_ROOT_PASSWORD="root" ; fi	
    local LIST_OF_NODES_FILE="${1}"
    local NODE INVENTORY_LIST
    if [ -n "${USER}" ] ; then local USER="${USER}@" 
	else                       local USER="root@"  
	fi    
	
    #---------------------------
    # ACTIONS
    #---------------------------
	
	# 1.- Load list of IP nodes
    if [ -r "${LIST_OF_NODES_FILE}" ] ; then
        . "${LIST_OF_NODES_FILE}" 2> /dev/null
    elif [ -r "${GENESIS_ANSIBLE_INVENTORY_SOURCE}" ] ; then
	    local INVENTORY_LIST=( $(runAdHoc ' ' '--list-hosts' | sed '1d') )
    fi
	
	# 2.- Detect Passwordless 
	echo "NODES.... [${INVENTORY_LIST[@]}]"
    if [ -n "${INVENTORY_LIST}" ] ; then
