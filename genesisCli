function error() {

	local RUTA_ACTUAL=`pwd`
	local TIMESTAMP=$(date -R)
    local LABEL="genesisCli"
	case "$1" in
		"-x"|"-noExec")   echo -e "[${TIMESTAMP}]: ${COLOR[$RED]} FATAL | [$LABEL] ABORTING: No {Exists/Execution Permisions} [$2] ${COLOR[$NC]}" ;;
		"-w"|"-noWrite")  echo -e "[${TIMESTAMP}]: ${COLOR[$RED]} FATAL | [$LABEL] ABORTING: No {Exists/Write Permisions} [$2] ${COLOR[$NC]}" ;;
		"-r"|"-noRead")   echo -e "[${TIMESTAMP}]: ${COLOR[$RED]} FATAL | [$LABEL] ABORTING: No {Exists/Read Permisions} [$2] ${COLOR[$NC]}" ;;
		"-e"|"-noExist")  echo -e "[${TIMESTAMP}]: ${COLOR[$RED]} FATAL | [$LABEL] ABORTING: No {File/Folder} found [$2] ${COLOR[$NC]}" ;;
