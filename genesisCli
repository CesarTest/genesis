#========================================================
#   Function: listaOpciones_Dinamica
#--------------------------------------------------------
#  List of files inside a folder is used as menu options
#========================================================
function listaOpciones_Dinamica() {

	#------------------
	# LOCAL ENVIRONMENT
	#------------------
	local INDICE="$1"
	local RUTA="${RUTA_OPCIONES[${INDICE}]}"
	local EXT="${EXT_OPCIONES[${INDICE}]}"
	local ELIMINA="${SUPRIME_EXT[${INDICE}]}"
    if [ -n "${MENU_SKIP_PATHS}" ] ; then local REMOVE_PATH="${MENU_SKIP_PATHS}" ; fi
	
	#-----------------
	# ACTIONS
	#-----------------
        if [ -r "${RUTA}" ] ; then
            local LIST_FILES=$(ls -1 -d "${RUTA}/"*${EXT} 2> /dev/null)
            if [ -n "${LIST_FILES[@]}" ] ; then
	        local INDICE="0"
	        for ELEMENTO in $(ls -1 -d "${RUTA}/"*${EXT} 2> /dev/null) ; do

		        # Nombre de la opcion  (with/without path-extension)
		        if [ -n "${REMOVE_PATH}" ] ; then local ELEMENTO="${ELEMENTO##*/}" ; fi
		        if [ -n "${ELIMINA}"     ] ; then local ELEMENTO="${ELEMENTO%%.*}" ; fi

                # Variables Publicas
		        ELEMENTOS_MENU[${INDICE}]="${ELEMENTO}"
		        NUM_OPCIONES="${INDICE}"

		        # Listando Opciones
		        echo -e "${INDICE} .- ${ELEMENTO}"
		        local INDICE=`expr "${INDICE}" + 1`
	        done
        else
           error "-r" "${RUTA}/*${EXT}"
        fi
    else
        error "-r" "${RUTA}"
    fi
}

