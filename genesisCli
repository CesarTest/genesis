#===================================================
#   Function: shootAdhoc
#---------------------------------------------------
#  Private Function
#
#  Shoot AdHoc ansible command
#===================================================
function shootAdhoc() {

   # 0.- Trace Entry
   if [ ! -n "${ATARGET}" ] ; then  local ATARGET="all" ; fi
   if [[ ! "${LOG}" == "/dev/null" ]] ; then
      echo "[${TIMESTAMP}] :  ansible  ${OPTIONS} ${ATARGET}"
   fi
   
   # 1.- Shoot Ad-Hoc Command
   if   [ -x /opt/stack/bifrost/bin/ansible ] ; then
        echo $OPTIONS
        /opt/stack/bifrost/bin/ansible  ${OPTIONS} ${ATARGET}
   elif [ -x /usr/bin/ansible    ] ; then
        /usr/bin/ansible ${ATARGET} ${OPTIONS} 
   elif [ -x /usr/sbin/ansible   ] ; then
         /usr/sbin/ansible ${ATARGET} ${OPTIONS} 		 
   elif [ -x /usr/bin/ansible-3  ] ; then
        /usr/bin/ansible-3 ${ATARGET} ${OPTIONS} 
   elif [ -x /usr/sbin/ansible-3 ] ; then
       /usr/sbin/ansible-3 ${ATARGET} ${OPTIONS} 
   else
     echo -e "${COLOR[$YELLOW]} [WARN] - GENESIS INSTALLATION FAILURE: ${COLOR[$NC]} please try to REFRESH Genesis Node (option 1)"
     error "-x" "ansible ${ATARGET} ${OPTIONS}"
   fi	
   
   unset OPTIONS
}

#===================================================
#   Function: shootCommand
#---------------------------------------------------
#  Private Function
#
#  Shoot Playbook not depending on enviromental parameters
#===================================================
function shootCommand() {

   #--------------------
   #  LOCAL ENVIRONMENT
   #--------------------
   local LOG="${1}"    
   local LOG_PATH="${LOG%/*}"
   local LOG_NAME="${LOG##*/}"
   local TIMESTAMP=$(date -R)

   #--------------------
   #  ACTIONS
   #--------------------

   # 0.- Trace values
   if [[ ! "${LOG}" == "/dev/null" ]] ; then   
      echo "......... PLAYBOOK=[${PLAYBOOK}]"
      echo ".......... OPTIONS=[${OPTIONS}]"
      echo ".............. LOG=[${LOG}]"
   fi
   
   # 1.- Ansible Logging Options
   export ANSIBLE_LOG_PATH
   export ANSIBLE_ACTION_WARNINGS ANSIBLE_COMMAND_WARNINGS ANSIBLE_DEPRECATION_WARNINGS ANSIBLE_DEVEL_WARNING ANSIBLE_LOCALHOST_WARNING ANSIBLE_SYSTEM_WARNINGS
   if [ -w "${LOG_PATH}" ] ; then export ANSIBLE_LOG_PATH="${LOG}"  ; fi
   if [ -n "${DISABLE_WARNS}" ] ; then
      export ANSIBLE_ACTION_WARNINGS=false
      export ANSIBLE_COMMAND_WARNINGS=false
      export ANSIBLE_DEPRECATION_WARNINGS=false
      export ANSIBLE_DEVEL_WARNING=false
      export ANSIBLE_LOCALHOST_WARNING=false
      export ANSIBLE_SYSTEM_WARNINGS=false
   fi

   # 2.- Shoot Playbook
   if [ -n "${PLAYBOOK}" ] ; then
      shootPlaybook "${PLAYBOOK}"
      
   elif [ -n "${ADHOC_MODULE}" ] ; then
      shootAdhoc
   fi
   
}

#========================================================
#   Function: runPlaybook
#--------------------------------------------------------
#  -Run diferent playbooks with the options captured
#========================================================
function runPlaybook() {
   local LOG="${1}"
   if [ ! -n "${LOG}" ] ; then local LOG="${HOME}/nolog.log" ; fi     
   buildCommand
   setupCommand
   shootCommand "${LOG}"
   unset INVENTORY PTARGET SLOT VAULT EXTRA_VARS ADHOC_MODULE ADHOC_CALL
 
}

#========================================================
#   Function: runAdHoc
#--------------------------------------------------------
#  -Run diferent playbooks with the options captured
#========================================================
function runAdHoc() {
   local ADHOC_MODULE="${1}"
   local ADHOC_CALL="${2}"
   local LOG="${3}"
   if [ ! -n "${LOG}" ] ; then local LOG="/dev/null" ; fi  
   buildCommand
   setupCommand
   shootCommand "${LOG}"
   unset INVENTORY PTARGET SLOT VAULT EXTRA_VARS ADHOC_MODULE ADHOC_CALL
}

