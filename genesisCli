         if [ -n "${RETURNING_MENU}" ] ; then MENU="${RETURNING_MENU}"   ; fi

         # 1.3.- Clean Loop Environment
         unset  MENU_TEXT SOLICITA_PARAMETRO PARAMETRO VALOR_DEFECTO RUTA_OPCIONES EXT_OPCIONES RUN_ACTION RETURNING_MENU MENU_SKIP_PATHS MENU_BREAK_TEXT

    done
}

########################################################################################
# MAIN
########################################################################################
if [ -w "/dev/null" ] ; then

    # ..... Move to home folder in order to avoid REFRESH issues
    if [ -w "${HOME}" ] ; then
         cd "${HOME}"
    else
         error -w "${HOME}"
    fi

    # ..... Load Context + Start Menu System
    if [ -O "./" ] ; then

		#=========================
		# ENVIRONMENT
		#=========================
		OUT_TMP="/tmp/reemplazo.out"
		MENU="0"

		#=============================
		# CAPTURE COMMAND FLAGS
		#=============================
		while getopts "hHAKPMGNRSLDi:t:s:v:l:g:b:p:" OPCION ; do
			case "$OPCION" in
				h|H)   ayuda ; exit 1 ;;
				R)   RUN_ACTION="1"  ; unset MENU ;;
				D)   RUN_ACTION="2"  ; unset MENU ;;
				L)   RUN_ACTION="3"  ; unset MENU ;;
				S)   RUN_ACTION="4"  ; unset MENU ;;
				A)   RUN_ACTION="5"  ; unset MENU ;;
				K)   RUN_ACTION="6"  ; unset MENU ;;
				P)   RUN_ACTION="7"  ; unset MENU ;;
				M)   RUN_ACTION="12" ; unset MENU ;;
				G)   RUN_ACTION="13" ; unset MENU ;;
				N)   RUN_ACTION="14" ; unset MENU ;;
				T)   RUN_ACTION="15" ; unset MENU ;;
                i)   if [ -n "$OPTARG" ] ; then INVENTORY="$OPTARG"  ; fi ;;
                t)   if [ -n "$OPTARG" ] ; then TARGET="$OPTARG"     ; fi ;;
                g)   if [ -n "$OPTARG" ] ; then CFGS_CORE="$OPTARG"  ; fi ;;
                s)   if [ -n "$OPTARG" ] ; then SLOT="$OPTARG"       ; fi ;;
                v)   if [ -n "$OPTARG" ] ; then VAULT="$OPTARG"      ; fi ;;
                l)   if [ -n "$OPTARG" ] ; then LOG_FILE="$OPTARG"   ; fi ;;
                b)   if [ -n "$OPTARG" ] ; then IDAS_BUILD="$OPTARG" ; fi ;;
                p)   if [ -n "$OPTARG" ] ; then PROJECT_NAME="$OPTARG" ; fi ;;				
				[?]) ayuda ;; # Unknown parameter
			esac
		done

		#=============================
		# ACTIONS
		#=============================

        # 1.- Localhost SSH User Key Handling
		state_status "genesis_machine_ready"

        # 2.- Direct Action
        if [ -n "${RUN_ACTION}"     ] ; then
            initParameters
            runActions "${RUN_ACTION}"
        fi

        # 3.- Menu System
        if [ -n "${MENU}" ] ; then startMenu ; fi

        # 4.- Exit
		exit "$OUT"
	else
		error -noOwner "./"
        exit "$ERROR"
	fi
else
	error -noWrite "/dev/null"
    exit "$ERROR"
fi
#=======================================================================================================
#  END genesisCli.sh
#=======================================================================================================
