#===================================================
#   Function: detectBackgroundExecution
#---------------------------------------------------
#  Private Function
#
#  Detect Background execution
#===================================================
detectBackgroundExecution() {
   local INPUT=$( echo "${RUN_BACKGROUND}" | tr '[:upper:]' '[:lower:]' )
   case "${INPUT}" in
       "s"|"si"|"y"|"yes" ) echo '---> Run Playbook in Background'
	   ;;
	  *) unset RUN_BACKGROUND 
	    ;;
   esac
}

