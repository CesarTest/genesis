    echo -e "  -b <GENESIS_BUILD> []    : Path to build file"
    echo -e "  -p <PROJECT_NAME> [pansa]    : Project Name to install"	
	echo -e "------------------------------------------------------"
        OUT="$OK"
}

#========================================================
#   Function: error
#--------------------------------------------------------
#  Print Error Messages
#
# Parameters:
#    $1 Type of Error
#    $2 Missing Parameters
#========================================================
function error() {

	local RUTA_ACTUAL=`pwd`
	local TIMESTAMP=$(date -R)
	local LABEL="genesisCli"
	case "$1" in
		"-x"|"-noExec")   echo -e "[${TIMESTAMP}]: ${COLOR[$RED]} FATAL | [${LABEL}] ABORTING: No {Exists/Execution Permisions} [$2] ${COLOR[$NC]}" ;;
		"-w"|"-noWrite")  echo -e "[${TIMESTAMP}]: ${COLOR[$RED]} FATAL | [${LABEL}] ABORTING: No {Exists/Write Permisions} [$2] ${COLOR[$NC]}" ;;
		"-r"|"-noRead")   echo -e "[${TIMESTAMP}]: ${COLOR[$RED]} FATAL | [${LABEL}] ABORTING: No {Exists/Read Permisions} [$2] ${COLOR[$NC]}" ;;
		"-e"|"-noExist")   echo -e "[${TIMESTAMP}]: ${COLOR[$RED]} FATAL | ${LABEL}] ABORTING: No {File/Folder} found [$2] ${COLOR[$NC]}" ;;

		"-o"|"-noOwner")  echo -e "[${TIMESTAMP}]: ${COLOR[$RED]} FATAL | [${LABEL}] ABORTING: No owner of path [$2] ${COLOR[$NC]}"
			              echo -e "[${TIMESTAMP}]: ${COLOR[$RED]} FATAL | [${LABEL}] ABORTING: Usually you need to be 'root' to shoot iDAS ${COLOR[$NC]}" ;;
		[?])              echo -e "[${TIMESTAMP}]: ${COLOR[$RED]} FATAL | [${LABEL}] ABORTING: Undefined error: [$2] ${COLOR[$NC]}" ;;
	esac

	OUT="${ERROR}"
}


#===================================================
#   Function: detectOS 
#---------------------------------------------------
#  Private Function
#
#  Detect Operating System
#===================================================
detectOS() {

 # 1.- Detect OS
 #--------------
 if [ -f /etc/os-release ]; then
    # freedesktop.org and systemd
    . /etc/os-release
    OS=$ID
    VER=$VERSION_ID
 elif type lsb_release >/dev/null 2>&1; then
    # linuxbase.org
    OS=$(lsb_release -si)
    VER=$(lsb_release -sr)
 elif [ -f /etc/lsb-release ]; then
    # For some versions of Debian/Ubuntu without lsb_release command
    . /etc/lsb-release
    OS=$DISTRIB_ID
    VER=$DISTRIB_RELEASE
 elif [ -f /etc/debian_version ]; then
    # Older Debian/Ubuntu/etc.
    OS=Debian
    VER=$(cat /etc/debian_version)
 elif [ -f /etc/SuSe-release ]; then
    # Older SuSE/etc.
    local SUSE=$(head -1 /etc/SuSe-release)
    local SUSE="${SUSE%%(*}"
    OS="${SUSE%% *}"
    VER=$(echo "${SUSE}" | tr -dc '0-9')
 elif [ -f /etc/redhat-release ]; then
    # Older Red Hat, CentOS, etc.
    local RH=$(cat /etc/redhat-release)
    OS="${RH%% *}"
    VER=$(echo "${RH}" | tr -dc '0-9')
 else
    # Fall back to uname, e.g. "Linux <version>", also works for BSD, etc.
    OS=$(uname -s)
    VER=$(uname -r)
 fi

 # 2.- Formatting Output
 #---------------
 OS=$( echo "${OS}"  | tr -d ' ' | tr [:upper:] [:lower:] )
 VER=$( echo "${VER}"  | tr -d ' ' | tr [:upper:] [:lower:] )
 LOG_HEADER="[${OS}-${VER}]-"
}

