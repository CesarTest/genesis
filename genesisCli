#========================================================
#   Function: replacePattern
#--------------------------------------------------------
#   Replace pattern in a text file
#========================================================
function replacePattern() {

   #---------------------
   # LOCAL ENVIRONMENT
   #---------------------
   local DEST_FILE="$1"
   local REPLACE_PATTERN="$2"
   local DETECTION_PATTERN="$3"

   #---------------------
   # ACTIONS
   #---------------------
   if [ -w "${DEST_FILE}" ] ; then
      if [ -n "${REPLACE_PATTERN}" ] ; then
         if [ -n "${DETECTION_PATTERN}" ] ; then
           echo "-> Replacing pattern: sed -i s|^${DETECTION_PATTERN}.*|${REPLACE_PATTERN}| ${DEST_FILE}"
           sed -i "s|^${DETECTION_PATTERN}.*|${REPLACE_PATTERN}| " "${DEST_FILE}"
         fi
      fi
   else
      error -w "${DEST_FILE}"
   fi
}

#========================================================
#   Function: vaultPass
#--------------------------------------------------------
#  -Create Vault File with encripted password
#========================================================
function vaultPass() {

   #---------------------
   # LOCAL ENVIRONMENT
   #---------------------
   local TMP_PATH="$1"
   local PASSWORD
   if [ ! -n "${TMP_PATH}" ] ; then local TMP_PATH="/tmp/" ; fi

   #---------------------
   # ACTIONS
   #---------------------

   # 1.- Removing Old Temp File
   #----------------
   if [ -w "${TMP_FILE}" ]  ; then
        echo "Removing Temporal Files... rm -f ${TMP_FILE}"
        rm -f "${TMP_FILE}" 2> /dev/null
        OUT="$?"
   fi

   # 2.- Create New Temp File
   #----------------
   if [ -w "${TMP_PATH}" ]  ; then

	  # 2.1.- Create Temp File with password encrypted
      if [ -x "/bin/mktemp" ] ||  [ -x "/sbin/mktemp" ] ; then
		 TMP_FILE=$(mktemp ${TMP_PATH}ansible.xsVtj.XXXX)
      else
         error "-x" "/bin/mktemp || /sbin/mktemp"
      fi		 
	  	 
	  # 2.2.- Create Encrypted Password	 
	  if [ -x "/bin/python" ] ||  [ -x "/sbin/python" ] ; then
         PASSWORD=$(python - <<END
import hashlib, base64, hmac
hash_code= hmac.HMAC(b"", b'${VAULT}', hashlib.sha512).digest()
base64_bytes = base64.b64encode(hash_code)
base64_string = base64_bytes.decode("ascii")
print(base64_string)
END
)
      elif [ -x "/bin/python3" ] ||  [ -x "/sbin/python3" ] ; then
         PASSWORD=$(python3 - <<END
import hashlib, base64, hmac
hash_code= hmac.HMAC(b"", b'${VAULT}', hashlib.sha512).digest()
base64_bytes = base64.b64encode(hash_code)
base64_string = base64_bytes.decode("ascii")
print(base64_string)
END
)		 
	  else
		  error "-x" "/bin/python3 || /sbin/python3 || /bin/python || /sbin/python"
	  fi
	  
      # 2.3.- Dump Encrypted Password in Temp File
	  if [ -n "${PASSWORD}" ] ; then
         if [ -w "${TMP_FILE}" ] ; then 	  
           echo "${PASSWORD}" > "${TMP_FILE}"
           OUT="$?"
		 else
		   error "-w" "${TMP_FILE}"
		 fi 
	  fi

   else
     error "-w" "${TMP_PATH}"
   fi

   # 3.- Clean Local Environment
   #----------------
   unset PASSWORD TMP_PATH
}

#========================================================
#   Function: buildCommand
#--------------------------------------------------------
#  -Build Playbook Options
#========================================================
function buildCommand() {

        # 0.- Defaults
        #----------------------
        if [ -n "${TARGET}"      ] ; then local PTARGET="localhost,${TARGET}"         ; fi

        # 1.- Build Playbook Options
        #----------------------
        OPTIONS=''
		if [ -n "${DEBUG_ANSIBLE_FLAGS}" ] ; then OPTIONS="${DEBUG_ANSIBLE_FLAGS} " ; fi
        if [ -n "${INVENTORY}"      ] ; then OPTIONS="${OPTIONS} -i ${INVENTORY}"   ; fi
        if [ -n "${ADHOC_MODULE}"   ]  && [ ! "${ADHOC_MODULE}" == ' ' ] ; then 
		     OPTIONS="${OPTIONS} -m ${ADHOC_MODULE}"  
		     if [ -n "${ADHOC_CALL}" ] && [ ! "${ADHOC_CALL}" == ' ' ] ; then 
			    OPTIONS="${OPTIONS} -a '${ADHOC_CALL}'" 
			 fi 	 
		elif [ -n "${ADHOC_CALL}" ] ; then 
		     OPTIONS="${OPTIONS} --list-hosts"		 
	    fi		
        if [ -n "${PTARGET}"        ] ; then OPTIONS="${OPTIONS} -l ${PTARGET}"     ; fi
		if [ -n "${FLUSH_CACHE}"    ] ; then OPTIONS="${OPTIONS} --flush-cache"     ; fi
        if [ -n "${EXTRA_VARS}"     ] ; then OPTIONS="${OPTIONS} -e ${EXTRA_VARS}"  ; fi	
        if [ -n "${TAGS}"           ] ; then OPTIONS="${OPTIONS} --tags ${TAGS}"  ; fi
        if [ -n "${VAULT}"          ] ; then
             vaultPass "/tmp/"
             OPTIONS="${OPTIONS} --vault-password-file ${TMP_FILE}"
        fi
		
        OUT="$?"
		
        # 3.- Logging
        #----------------------
        if [ ! "${LOG}" == "/dev/null" ] ; then
           echo "........ INVENTORY=[${INVENTORY}]"
           echo "........... TARGET=[${PTARGET}]"
           echo "............. TAGS=[${TAGS}]"		   
           echo "............ VAULT=[${VAULT}]"
           echo "....... EXTRA_VARS=[${EXTRA_VARS}]"
           echo "..... ADHOC_MODULE=[${ADHOC_MODULE}]"
           echo "....... ADHOC_CALL=[${ADHOC_CALL}]"
        fi
}

