#========================================================
#   Function: passwordlessDetection
#--------------------------------------------------------
#  -Generate User SSH key in localhost
#  -Ensure localhost passwordless access
#========================================================
function passwordlessDetection() {

    #------------------
    # LOCAL ENVIRONMENT
    #------------------
    local HOST="${1}"
    local USER="${2}"
    local SSH_TIMEOUT="3"
    if [ -n "${USER}" ] ; then local USER="${USER}@" ; fi

    #------------------
    # ACTIONS
    #------------------
    local PASSWORDLESS_DETECTED="$(ssh -oBatchMode='yes' -oConnectTimeout=${SSH_TIMEOUT} ${USER}${HOST} 'echo DONE' 2> /dev/null
)"
    if [ "${PASSWORDLESS_DETECTED}" == "DONE" ] ; then
        echo "Passwordless already Enabled at ${USER}${HOST}"
    else
        ssh-copy-id -oConnectTimeout="${SSH_TIMEOUT}" "${USER}${HOST}" 2> "${OUT_TMP}"
        local SUCCESS="$?"
        local OUTPUT_COPY=$(cat ${OUT_TMP} | grep ERR)
        echo "Passwordless was successfully Established at ${USER}${HOST}? [$SUCCESS] (OK=$OK, ERROR=$ERROR) ${OUTPUT_COPY}"
    fi
    OUT="$?"
}

#========================================================
#   Function: sshUserKey
#--------------------------------------------------------
#  -Generate User SSH key in localhost
#  -Ensure localhost passwordless access
#========================================================
function sshUserKey() {

    # 1.- Create SSH folder
    #-----------------------
    if [ ! -e "${HOME}/.ssh" ] ; then
       mkdir -p "${HOME}/.ssh"
       chmod 700 "${HOME}/.ssh"
    fi

    # 2.- Detect SSH Keys
    #-----------------------
    local KEYS="$(ls ${HOME}/.ssh/*pub 2> /dev/null)"
    echo -e ".... User SSH Keys detected: \n$KEYS"
    if [ ! -n "${KEYS}" ] ; then
       if [ -x "/bin/ssh-keygen" ] || [ -x "/sbin/ssh-keygen" ] ; then
          echo "............................................................................"
          echo " No SSH Key detected on this user... we proceed with interactive generation"
          echo "............................................................................"
          ssh-keygen
       fi
    fi

    # 3.- Localhost Passwordless SSH Access
    #-----------------------
    local USER="$(whoami)"
    passwordlessDetection "localhost" "${USER}"
}

#========================================================
#   Function: trust_relationships
#--------------------------------------------------------
#  -Generate User SSH key in localhost
#  -Ensure localhost passwordless access
#========================================================
function trust_relationships() {

    #---------------------------
    # LOCAL ENVIRONMENT
    #---------------------------
    local LIST_OF_NODES_FILE="${1}"
    local NODE INVENTORY_LIST

    #---------------------------
    # ACTIONS
    #---------------------------
    if [ -r "${LIST_OF_NODES_FILE}" ] ; then
        . "${LIST_OF_NODES_FILE}" 2> /dev/null
    elif [ -r "/etc/core/inventory_ip" ] ; then
	local INVENTORY_LIST=( $(ansible all -i /etc/core/inventory_ip --list-hosts| sed '1d') )
    fi

    if [ -n "${INVENTORY_LIST}" ] ; then
       for NODE in "${INVENTORY_LIST[@]}" ; do
           passwordlessDetection "${NODE}" "root"
           OUT="$?"
       done
    else
       echo -e "${COLOR[$YELLOW]} [WARN] - MISSING CONFIGURATION FILE: please try to SETUP Genesis before ${COLOR[$NC]}"
       error "-r" "${LIST_OF_NODES_FILE}"
    fi
    unset NODE INVENTORY_LIST LIST_OF_NODES_FILE
}


